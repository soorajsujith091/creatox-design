      },
      {
        "type": "paragraph",
        "text": "Started a freelancing agency, worked with the best websites and international projects"
      },
      {
        "type": "heading",
        "text": "2020"
      },
      {
        "type": "paragraph",
        "text": "Established own office in Kannur. Worked on Socials, Designs & Web Design projects in Kerala & Dubai"
